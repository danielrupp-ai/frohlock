# FrohLock-Brücke – Beispielkonfiguration. Kopieren nach .env und anpassen.

# Öffentliche HTTPS-Adresse, die den Geräten in die Config geschrieben wird.
FROHLOCK_PUBLIC_URL=https://frohlock.example.de

# Privater Signaturschlüssel (NUR auf dem Server!).
FROHLOCK_SIGNING_KEY=/etc/frohlock/signing_private.pem

# SPKI-SHA256-Pins des Serverzertifikats (Base64, kommagetrennt, inkl. Backup-Pin).
# Leer lassen = kein Pinning (nur Dev).
FROHLOCK_TLS_PINS=

# Admin-Login.
FROHLOCK_ADMIN_USER=admin
FROHLOCK_ADMIN_PASSWORD=bitte-aendern

# Fester Session-Schlüssel (sonst werden Admin-Sessions bei Neustart ungültig).
FROHLOCK_SESSION_SECRET=bitte-langen-zufallswert-setzen

# E-Mail-Versand für PIN-Reset (ohne Host wird der Link nur ins Log geschrieben).
FROHLOCK_SMTP_HOST=
FROHLOCK_SMTP_PORT=587
FROHLOCK_SMTP_USER=
FROHLOCK_SMTP_PASSWORD=
FROHLOCK_SMTP_FROM=FrohLock <noreply@froehlichdienste.de>
FROHLOCK_SMTP_STARTTLS=1

# Datenbank.
FROHLOCK_DB=/var/lib/frohlock/app.db

# Aktuelles Client-Update (optional).
FROHLOCK_UPDATE_VERSION=
FROHLOCK_UPDATE_URL=
FROHLOCK_UPDATE_SHA256=
