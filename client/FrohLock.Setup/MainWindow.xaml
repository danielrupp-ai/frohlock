<Window x:Class="FrohLock.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FrohLock – Einrichtung" Height="720" Width="560"
        Background="#0F1720" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EEF2F7"/></Style>
    <Style TargetType="Label"><Setter Property="Foreground" Value="#9FB3C8"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#2E7D32"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,7"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock Text="🔒 FrohLock einrichten" FontSize="24" FontWeight="Bold" Margin="0,0,0,4"/>
      <TextBlock Text="Bildschirmzeit-Schutz für den Kinder-Laptop" Foreground="#9FB3C8" Margin="0,0,0,20"/>

      <!-- 1. Kopplung -->
      <Border Background="#13294B" CornerRadius="10" Padding="16" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="1) Mit der Brücke koppeln" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <Label Content="Server-Adresse"/>
          <TextBox x:Name="ServerUrlBox" Padding="8" Margin="0,0,0,8"/>
          <Label Content="Kopplungscode (aus der Admin-Brücke)"/>
          <TextBox x:Name="PairingBox" Padding="8" Margin="0,0,0,8"/>
          <Label Content="Gerätename"/>
          <TextBox x:Name="DeviceNameBox" Text="Laptop Kind" Padding="8" Margin="0,0,0,10"/>
          <Button x:Name="PairButton" Content="Koppeln" HorizontalAlignment="Left" Click="Pair_Click"/>
          <TextBlock x:Name="PairStatus" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- 2. PIN -->
      <Border Background="#13294B" CornerRadius="10" Padding="16" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="2) Eltern-PIN vergeben" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <TextBlock Text="Mit diesem PIN wird das Gerät entsperrt. Mind. 4 Zeichen." Foreground="#9FB3C8" Margin="0,0,0,8"/>
          <Label Content="PIN"/>
          <PasswordBox x:Name="PinBox" Padding="8" Margin="0,0,0,8" MaxLength="32"/>
          <Label Content="PIN wiederholen"/>
          <PasswordBox x:Name="PinConfirmBox" Padding="8" Margin="0,0,0,10" MaxLength="32"/>

          <Label Content="E-Mail für PIN-Zurücksetzen (der Eltern)"/>
          <TextBox x:Name="EmailBox" Padding="8" Margin="0,0,0,4"/>
          <TextBlock Text="Falls du den PIN mal vergisst, kannst du ihn über einen Link an diese E-Mail zurücksetzen."
                     Foreground="#9FB3C8" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- 3. Sperrzeiten -->
      <Border Background="#13294B" CornerRadius="10" Padding="16" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="3) Sperrzeiten festlegen" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <TextBlock Text="In diesen Zeiten ist der Laptop komplett gesperrt (Kernfunktion)." Foreground="#9FB3C8" Margin="0,0,0,10"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Label Content="von" VerticalAlignment="Center"/>
            <TextBox x:Name="StartBox" Text="21:00" Width="70" Padding="6" Margin="4,0,12,0"/>
            <Label Content="bis" VerticalAlignment="Center"/>
            <TextBox x:Name="EndBox" Text="07:00" Width="70" Padding="6" Margin="4,0,0,0"/>
          </StackPanel>
          <WrapPanel x:Name="DaysPanel" Margin="0,0,0,10"/>
          <Button Content="Sperrzeit hinzufügen" HorizontalAlignment="Left" Background="#37475E" Click="AddWindow_Click"/>
          <ItemsControl x:Name="WindowsList" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="#0B1F3A" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Background="#C62828" Padding="8,2"
                            Click="RemoveWindow_Click" Tag="{Binding Id}"/>
                    <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Button x:Name="SaveButton" Content="Speichern &amp; aktivieren" FontSize="15" Padding="14,10"
              Click="Save_Click" IsEnabled="False"/>
      <TextBlock x:Name="SaveStatus" Margin="0,12,0,0" TextWrapping="Wrap"/>
      <Border x:Name="ForgotBox" Background="#13294B" CornerRadius="10" Padding="14" Margin="0,12,0,0"
              Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="🔑 PIN vergessen?" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock x:Name="ForgotInfo" Foreground="#CFE0FF" FontSize="13" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
