<Window x:Class="FrohLock.Setup.UninstallGateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FrohLock entfernen?" Height="330" Width="440"
        Background="#0F1720" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Topmost="True">
  <StackPanel Margin="24">
    <TextBlock Text="🔒 FrohLock entfernen?" FontSize="20" FontWeight="Bold" Foreground="#EEF2F7"/>
    <TextBlock Margin="0,10,0,0" Foreground="#CFE0FF" TextWrapping="Wrap"
               Text="FrohLock ist eine Kindersicherung. Sie kann NUR von den Eltern mit dem PIN entfernt werden. Ohne PIN ist keine Deinstallation möglich."/>

    <!-- Schritt 1: nur „Nein" oder „mit PIN entfernen" -->
    <StackPanel x:Name="ChoicePanel" Margin="0,20,0,0">
      <Button Content="Nein, FrohLock behalten" FontSize="15" Padding="12,10" Click="Keep_Click"
              Background="#2E7D32" Foreground="White" BorderThickness="0" Cursor="Hand" IsDefault="True"/>
      <Button Content="Mit Eltern-PIN entfernen" FontSize="13" Padding="10,8" Margin="0,10,0,0"
              Click="ShowPin_Click" Background="#37475E" Foreground="White" BorderThickness="0" Cursor="Hand"/>
    </StackPanel>

    <!-- Schritt 2: PIN-Eingabe (erst nach Klick sichtbar) -->
    <StackPanel x:Name="PinPanel" Margin="0,20,0,0" Visibility="Collapsed">
      <TextBlock Text="Eltern-PIN eingeben, um FrohLock zu entfernen:" Foreground="#9FB3C8" Margin="0,0,0,6"/>
      <PasswordBox x:Name="PinBox" FontSize="18" Padding="10" MaxLength="32" KeyDown="PinBox_KeyDown"/>
      <TextBlock x:Name="ErrText" Foreground="#FF8A80" FontSize="12" Margin="0,6,0,0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button Content="Abbrechen" Padding="12,7" Margin="0,0,8,0" Click="Keep_Click"/>
        <Button Content="Entfernen bestätigen" Padding="14,7" Click="Confirm_Click"
                Background="#C62828" Foreground="White" BorderThickness="0" Cursor="Hand"/>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</Window>
