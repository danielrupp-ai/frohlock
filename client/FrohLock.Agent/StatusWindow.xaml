<Window x:Class="FrohLock.Agent.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FrohLock – Übersicht" Height="460" Width="480"
        Background="#0F1720" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EEF2F7"/></Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock Text="🌙 FrohLock" FontSize="22" FontWeight="Bold"/>
      <TextBlock Text="Bildschirmzeit-Übersicht" Foreground="#9FB3C8" Margin="0,0,0,18"/>

      <Border Background="#13294B" CornerRadius="12" Padding="18" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock x:Name="StateText" Text="…" FontSize="26" FontWeight="Bold"/>
          <TextBlock x:Name="ReasonText" Text="" Foreground="#9FB3C8" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Background="#13294B" CornerRadius="12" Padding="18" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="Sperrzeiten heute" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBlock x:Name="ScheduleText" Text="…" Foreground="#CFE0FF" TextWrapping="Wrap"/>
          <TextBlock x:Name="NextLockText" Text="" Foreground="#9FB3C8" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>

      <Border Background="#13294B" CornerRadius="12" Padding="18">
        <StackPanel>
          <TextBlock Text="Tageslimit (Gesamtnutzung)" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBlock x:Name="BudgetText" Text="…" Foreground="#CFE0FF"/>
          <Border x:Name="BarBack" Background="#22FFFFFF" CornerRadius="6" Height="14" Margin="0,8,0,0">
            <Border x:Name="BarFill" Background="#43A047" CornerRadius="6" Height="14"
                    HorizontalAlignment="Left" Width="0"/>
          </Border>
        </StackPanel>
      </Border>

      <TextBlock x:Name="FootText" Text="" Foreground="#66FFFFFF" FontSize="11"
                 HorizontalAlignment="Center" Margin="0,16,0,0"/>
    </StackPanel>
  </ScrollViewer>
</Window>
