<Window x:Class="FrohLock.Agent.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FrohLock" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        Background="#0B1F3A" Foreground="White" Cursor="Arrow">
  <Grid>
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
      <TextBlock Text="🔒" FontSize="72" HorizontalAlignment="Center" Margin="0,0,0,8"/>
      <TextBlock Text="Gerät gesperrt" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"/>
      <TextBlock x:Name="ReasonText" Text="" FontSize="16" Opacity="0.8"
                 HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
      <TextBlock x:Name="ClockText" Text="" FontSize="15" Opacity="0.6"
                 HorizontalAlignment="Center" Margin="0,4,0,24"/>

      <Border Background="#13294B" CornerRadius="12" Padding="24" >
        <StackPanel>
          <TextBlock Text="PIN der Eltern zum Entsperren:" FontSize="14" Margin="0,0,0,8"/>
          <PasswordBox x:Name="PinBox" FontSize="22" Padding="10" MaxLength="32"
                       Background="#0B1F3A" Foreground="White" CaretBrush="White"
                       KeyDown="PinBox_KeyDown"/>
          <Button x:Name="UnlockButton" Content="Entsperren" FontSize="16" Margin="0,12,0,0"
                  Padding="10,8" Click="UnlockButton_Click" Background="#2E7D32" Foreground="White"
                  BorderThickness="0"/>
          <TextBlock x:Name="FeedbackText" Text="" FontSize="13" Foreground="#FF8A80"
                     HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <TextBlock Text="FrohLock – Bildschirmzeit-Schutz" FontSize="11" Opacity="0.4"
                 HorizontalAlignment="Center" Margin="0,24,0,0"/>
    </StackPanel>
  </Grid>
</Window>
