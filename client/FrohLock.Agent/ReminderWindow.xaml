<Window x:Class="FrohLock.Agent.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FrohLock" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" ShowActivated="False" AllowsTransparency="True" Background="Transparent"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual">
  <Border CornerRadius="18" Padding="18,14" Margin="14">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3457B4" Offset="0"/>
        <GradientStop Color="#6A4CC0" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
    </Border.Effect>
    <StackPanel Orientation="Horizontal" MaxWidth="420">
      <TextBlock Text="🌙" FontSize="44" VerticalAlignment="Center" Margin="0,0,14,0"/>
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" Text="Bald ist Schlafenszeit!" Foreground="White"
                   FontSize="18" FontWeight="Bold"/>
        <TextBlock x:Name="BodyText" Foreground="#EAF0FF" FontSize="14" TextWrapping="Wrap"
                   Text="Mach dich langsam bettfertig. 🦷🛏️"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
