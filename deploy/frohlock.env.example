# Konkrete Kopie liegt auf dem Server als ~/apps/frohlock/frohlock.env (chmod 600, NICHT im Git).
FROHLOCK_PUBLIC_URL=https://frohlock.froehlichdienste.de
FROHLOCK_SIGNING_KEY=/secrets/signing_private.pem
FROHLOCK_DB=/data/app.db
FROHLOCK_ADMIN_USER=admin
FROHLOCK_ADMIN_PASSWORD=CHANGE_ME
FROHLOCK_SESSION_SECRET=CHANGE_ME_LONG_RANDOM
FROHLOCK_TLS_PINS=
# Optional für Reset-Mails:
FROHLOCK_SMTP_HOST=
FROHLOCK_SMTP_PORT=587
FROHLOCK_SMTP_USER=
FROHLOCK_SMTP_PASSWORD=
FROHLOCK_SMTP_FROM=FrohLock <noreply@froehlichdienste.de>
